# --- Python Environment ---
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
.env

# --- Database & Persistence ---
# Ignore local TimescaleDB/Postgres data dumps or logs
*.sql
!core/migrations/*.sql
*.dump
*.log

# Redis persistence files
*.rdb
*.aof

# --- IDE & System (WSL2/Windows) ---
.vscode/
.claude/
.cursor/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Large Data / Trading Logs ---
# Since you're doing quant work, ignore massive CSVs or Parquet files
data/
*.csv
!docs/archive/*.csv
!tests/state_machine/fixtures/*.csv
*.parquet
*.log

# --- Frontend ---
node_modules/
dist/
.env.local
data.backup-*/
keep_data.backup-*/

# --- Debug-session artifacts (Playwright browser + root screenshots) ---
.playwright-mcp/
/*.png

# --- .NET / Quantower plugin build artifacts ---
# obj/ and bin/ are reproducible from the .csproj source. T156 latent
# noted these were being tracked and modified silently on every IDE
# build; T157 removes them from the index. The .NET SDK regenerates
# these locally on the next `dotnet build`.
QuantowerRiskPlugin/obj/
QuantowerRiskPlugin/bin/